# MongoDB Atlas connection string
# Get this from https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/arges?retryWrites=true&w=majority

# JWT secret (change this to a random string for production)
JWT_SECRET=arges-dev-secret-change-in-production

# Server port
PORT=3001
